{
  "name": "@atlas/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Supabase Auth client foundation for Project Atlas. See ADR-006 and docs/05-api/authentication.md. Does NOT contain Role/Permission/Membership (RBAC) logic \u2014 that is Identity domain scope, starting Sprint 1.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "@atlas/config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}

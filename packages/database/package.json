{
  "name": "@atlas/database",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle ORM schema, migrations, and typed database client for Project Atlas. See docs/04-database/.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "check-connection": "tsx src/check-connection.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@atlas/config": "workspace:*",
    "drizzle-orm": "^0.36.1",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "drizzle-kit": "^0.27.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}

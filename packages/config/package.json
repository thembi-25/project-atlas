{
  "name": "@atlas/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript/ESLint base configuration and typed environment schema for Project Atlas.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./eslint-base.js": "./eslint-base.js"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}

{
  "name": "@atlas/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Project Atlas background worker (pg-boss job processor). See ADR-016 and docs/02-architecture/container-architecture.md.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@atlas/analytics": "workspace:*",
    "@atlas/config": "workspace:*",
    "@atlas/crm": "workspace:*",
    "@atlas/database": "workspace:*",
    "@atlas/financials": "workspace:*",
    "@atlas/identity": "workspace:*",
    "@atlas/integrations": "workspace:*",
    "@atlas/jobs": "workspace:*",
    "@atlas/notifications": "workspace:*",
    "@atlas/quickbooks": "workspace:*",
    "@atlas/scheduling": "workspace:*",
    "drizzle-orm": "^0.36.1",
    "pg-boss": "^10.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}

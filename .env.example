# Project Atlas — Environment Variables
#
# Copy this file to .env.local (for apps/web and local tooling) and never commit
# the real values. See docs/07-security/secrets-management.md and
# docs/10-devops/local-development.md for the full policy.
#
# Variables prefixed NEXT_PUBLIC_ are bundled into the browser — only ever put
# genuinely public values there. Everything else stays server-only.

# --- Application ---
NODE_ENV=development
# Base URL the app is served from (used for absolute links, redirects).
APP_URL=http://localhost:3000

# --- Supabase ---
# Project URL and anon key are safe for the browser (RLS enforces isolation).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Service-role key bypasses RLS. Server-only. NEVER prefix with NEXT_PUBLIC_.
# Used only by narrow, reviewed platform-admin code paths — see
# docs/07-security/authorization-security.md, "Service-role usage".
# NEVER commit a real value here — this is a template file. If a real key
# ever ends up in this file, treat it as compromised and rotate it
# immediately in the Supabase dashboard (Project Settings -> API).
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# --- Database (Drizzle) ---
# Direct Postgres connection string, server-only. Used by packages/database
# and apps/worker. See docs/04-database/database-architecture.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Background Worker (pg-boss) ---
# Defaults to DATABASE_URL if unset; separate var allows a distinct
# connection (e.g., session-mode pooling) per docs/02-architecture/container-architecture.md.
WORKER_DATABASE_URL=

# --- Observability ---
# Optional. If unset, Sentry initialization is skipped (see apps/web/lib/logger.ts).
# Server-side DSN.
SENTRY_DSN=
# Public DSN for browser-side error capture (safe to expose).
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# --- Third-party integrations ---
# Documented here per docs/02-architecture/technology-stack.md so the full
# required variable surface is visible from Sprint 0. Stripe (ADR-018) is
# used starting Sprint 5 — see packages/integrations/src/stripe/,
# apps/web/app/portal/invoices/[id]/pay/page.tsx. Resend/Twilio/QuickBooks
# (ADR-017/ADR-019) are used starting Sprint 7 — see
# packages/integrations/src/{resend,twilio,quickbooks}/. None of these six
# are configured in this sandbox; every function that needs one fails
# loudly rather than silently no-op'ing (see each provider's client.ts).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
